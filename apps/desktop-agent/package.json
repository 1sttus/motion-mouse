{
  "name": "@motion-mouse/desktop-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": "index.js",
  "description": "Windows desktop receiver and per-platform pointer adapter boundary.",
  "scripts": {
    "start": "node index.js",
    "build:win": "node scripts/build-win.mjs"
  },
  "pkg": {
    "assets": [
      "src/receiver/pairing-store.json",
      "../../node_modules/systray2/traybin/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "@motion-mouse/protocol": "0.1.0",
    "qrcode-terminal": "^0.12.0",
    "selfsigned": "^5.4.0",
    "systray2": "^2.1.4",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1",
    "shelljs": "^0.10.0"
  }
}
